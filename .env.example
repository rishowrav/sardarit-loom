# ---------------------------------------------------------------------------
# SardarIT Loom — environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` (it is git-ignored) and never expose these values
# in client code: only variables starting with `NEXT_PUBLIC_` reach the browser.
# ---------------------------------------------------------------------------

# Optional local-only mode: no sign-in or cloud services; saves videos under data/local.
# Active only with npm run dev; production builds cannot enable it.
# LOCAL_DEMO_MODE=true

# --- Supabase (Authentication + Database) ----------------------------------
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The ONLY email allowed to log in (single-user app).
# Create this user once in Supabase Dashboard → Authentication → Users → Add user,
# then disable public sign-ups (Authentication → Providers → Email → Disable signups).
OWNER_EMAIL=you@example.com

# --- Video storage: any S3-compatible store (Backblaze B2 / Cloudflare R2) --
# Bucket name (must exist, and stay PRIVATE)
R2_BUCKET=sardarit-loom

# === Backblaze B2 (default choice) ===
# Backblaze console → bucket → Endpoint, e.g. https://s3.us-west-004.backblazeb2.com
R2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# The bucket's region shown next to the endpoint (e.g. us-west-004). MUST match.
R2_REGION=us-west-004
# Application Keys → "Add a new key" (scope it to this bucket; read/write/delete files)
R2_ACCESS_KEY_ID=your_b2_application_key_id
R2_SECRET_ACCESS_KEY=your_b2_application_key
# Leave false (virtual-hosted style works). If presigned links ever 404, set true.
R2_FORCE_PATH_STYLE=false

# === Alternative: Cloudflare R2 ===
# Comment out R2_ENDPOINT / R2_REGION above and use instead:
# R2_ACCOUNT_ID=your_cloudflare_account_id
# (region defaults to "auto")

# --- Behaviour tuning (optional, sensible defaults apply) -------------------
# Storage quota in gigabytes. When reached after an upload, the OLDEST completed
# recordings are deleted first. Incomplete/active uploads are never auto-deleted.
STORAGE_LIMIT_GB=20
# Upload chunk size in megabytes (R2 multipart minimum is 5 MB except last part)
CHUNK_SIZE_MB=8
# Lifetime (seconds) of temporary playback/download links — 6 hours by default
PRESIGN_TTL_SECONDS=21600
